{% render 'purelane-assets' %}

<section
  id="shop"
  class="pl-sec purelane-shop"
  data-section-type="purelane-shop"
  style="--pl-bg-tint: {{ section.settings.background_tint }}; --pl-pt: {{ section.settings.padding_top }}px; --pl-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="pl-wrap">
    {% render 'purelane-panel-head',
      kicker: section.settings.kicker,
      heading: section.settings.heading,
      align: 'center'
    %}

    {%- assign shop_collection = section.settings.collection -%}
    {%- if shop_collection != blank and shop_collection.products.size > 0 -%}
      <div class="pl-shelf">
        {%- for product in shop_collection.products limit: section.settings.products_limit -%}
          <div class="pl-rv pl-rv-{% assign rv_i = forloop.index | modulo: 3 %}{% if rv_i == 0 %}3{% else %}{{ rv_i }}{% endif %}">
            {%- render 'purelane-product-card', card_product: product, card_settings: section.settings -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="pl-empty">{{ section.settings.empty_state_text }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane Shop",
  "tag": "section",
  "class": "purelane-shop",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_limit", "label": "Products limit", "min": 1, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "textarea", "id": "empty_state_text", "label": "Empty state text", "default": "No products yet. Pick a collection to show the shop grid." },
    { "type": "header", "content": "Ratings" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "range", "id": "default_rating", "label": "Default rating", "min": 0, "max": 5, "step": 0.1, "default": 4.8 },
    { "type": "number", "id": "default_review_count", "label": "Default review count", "default": 237 },
    { "type": "header", "content": "Badges (from product tags)" },
    { "type": "checkbox", "id": "show_badges", "label": "Show badges", "default": true },
    { "type": "text", "id": "bestseller_tag_label", "label": "Tag \"bestseller\" label", "default": "Best seller" },
    { "type": "text", "id": "toprated_tag_label", "label": "Tag \"toprated\" label", "default": "Top rated" },
    { "type": "text", "id": "new_tag_label", "label": "Tag \"new\" label", "default": "New" },
    { "type": "header", "content": "Prices" },
    { "type": "checkbox", "id": "show_compare_at", "label": "Show compare-at price", "default": true },
    { "type": "checkbox", "id": "show_percent_off", "label": "Show % off", "default": true },
    { "type": "header", "content": "Add to cart" },
    { "type": "text", "id": "add_to_cart_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "background_tint", "label": "Background tint", "default": "#00000000" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 34 }
  ],
  "presets": [
    { "name": "Purelane Shop" }
  ]
}
{% endschema %}
